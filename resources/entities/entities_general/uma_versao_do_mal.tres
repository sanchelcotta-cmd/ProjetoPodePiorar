[resource]
script = ExtResource("1_6jnfk")
display_name = "Uma versão igual a você só que do mal"
description = "Ao iniciar o Encontro, copia a Maestria, o Ataque e a Vida base do personagem que ativou este bloco. Os valores copiados não são atualizados durante o Encontro. "
narrative_description = "Um calafrio percorre seu corpo ao avistar, do outro lado da calçada, alguém. É como se olhar no espelho. Aquilo é idêntico a você rosto, os movimentos e até a postura são exatamente os mesmos, mas existe algo profundamente errado naquele olhar."
