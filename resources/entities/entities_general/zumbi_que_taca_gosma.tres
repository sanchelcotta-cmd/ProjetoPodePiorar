[resource]
script = ExtResource("1_7568b")
display_name = "Zumbi Que taca gosma"
description = "Criatura zumbificada que atira gosma que pode causar doença.
Ao início do 3º turno do Encontro, caso pelo menos um Zumbi que Taca Gosma tenha permanecido vivo durante os dois primeiros turnos completos do combate, são invocados Zumbis Dançarinos. "
narrative_description = "É difícil dizer onde termina o zumbi e onde começa a meleca. Em alguns momentos, parece que a gosma é quem está carregando o moribundo, e não o contrário."
vida_base = 10
ataque_base = 4
