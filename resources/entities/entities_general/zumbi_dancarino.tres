[resource]
script = ExtResource("1_agpdo")
id = &"en_00033"
display_name = "Zumbi Dançarino"
description = "Criatura zumbificada que pode causar doença ao atacar. Anda em grupo."
narrative_description = "A pele esverdeada, as olheiras profundas e os sorrisos vazios já seriam estranhos o suficiente. Mas eles continuam dançando, repetindo uma coreografia silenciosa que ninguém consegue ouvir. Quando percebem a presença de vocês, os passos permanecem exatamente os mesmos. Só muda a direção da dança."
