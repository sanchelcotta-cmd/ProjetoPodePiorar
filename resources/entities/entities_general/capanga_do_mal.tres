[resource]
script = ExtResource("1_344i6")
display_name = "Capanga Do Mal"
description = "Aprimora seus atributos ao longo do combate:
A partir do início de seu 2º turno, recebe +1 de Ataque no início de cada um de seus turnos, acumulando esse bônus até o fim do combate."
narrative_description = "Vestindo um terno barato e um sorriso convencido, ele parece ter saído diretamente de algum filme de ação de quinta categoria. A cada passo demonstra uma confiança irritante, como se tivesse absoluta certeza de que, cedo ou tarde, vai conseguir acertar vocês."
