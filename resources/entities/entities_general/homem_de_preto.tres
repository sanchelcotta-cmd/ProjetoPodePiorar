[resource]
script = ExtResource("1_lqeph")
id = &"en_00019"
display_name = "Homem de Preto"
description = "Se o grupo não possuir nenhuma Informação, o Homem de Preto não realiza ataques, e o Encontro é encerrado imediatamente. Caso contrário, Ataque e Stamina são definidos pelo número de Informações do grupo, limitados conforme o distrito."
narrative_description = "Vestindo um terno impecável, chapéu preto e uma expressão completamente vazia, ele permanece parado como se já esperasse pela chegada de vocês. A pele excessivamente pálida e a ausência de sobrancelhas tornam seu rosto difícil de esquecer. Enquanto vocês observam a figura, ela continua encarando o grupo, como se estivesse calculando alguma coisa."
vida_base = 55
maestrias = Array[int]([1, 3])
skill_passivas = Array[ExtResource("2_c1om5")]([ExtResource("3_mastery"), ExtResource("4_attack"), ExtResource("5_end")])
tags = Array[StringName]([&"core_homens_de_preto", &"humanoide", &"atributo_variavel", &"suburbio", &"baixo_centro", &"centro"])
metadata/_custom_type_script = "uid://8ma4cswg5n35"
