[resource]
script = ExtResource("1_lqeph")
display_name = "Homem de Preto"
description = "Se o grupo não possuir nenhuma Informação, o Homem de Preto não realiza ataques, e o Encontro é encerrado imediatamente."
narrative_description = "Vestindo um terno impecável, chapéu preto e uma expressão completamente vazia, ele permanece parado como se já esperasse pela chegada de vocês. A pele excessivamente pálida e a ausência de sobrancelhas tornam seu rosto difícil de esquecer. Enquanto vocês observam a figura, ela continua encarando o grupo, como se estivesse calculando alguma coisa."
vida_base = 55
