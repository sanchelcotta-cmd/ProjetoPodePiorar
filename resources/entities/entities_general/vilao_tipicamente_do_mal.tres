[resource]
script = ExtResource("1_qkdxl")
display_name = "Vilão-Tipicamente Do Mal"
description = "No início do combate e no início de cada um de seus turnos, há 50% de chance de invocar um \"Capanga do Mal\", no máximo 3. Caso existam 3 Capangas do Mal em combate, este gatilho não é ativado."
narrative_description = "A risada exagerada chega antes da imagem. Vestido com roupas espalhafatosas e um sorriso convencido, ele aponta teatralmente na sua direção enquanto recita um discurso que claramente foi ensaiado inúmeras vezes em frente ao espelho"
