[resource]
script = ExtResource("1_6yegx")
display_name = "Servo Invocador 1"
description = "Nos turnos 3, 6, 9 (todos os múltiplos de 3), invoca uma Sombra Disforme. Podem existir, no máximo, 3 Sombras Disformes vivas em campo invocadas por este Servo. Caso esse limite já tenha sido atingido, em vez de invocar, realiza um ataque normalmente."
narrative_description = "Ele abre um livro escrito numa língua impossível e começa a ler em voz alta. O pior não é ele conseguir pronunciar aquilo. O pior é quando uma sombra surge para corrigir a pronúncia."
vida_base = 40
ataque_base = 5
stamina_base = 5
