[resource]
script = ExtResource("1_5g3di")
display_name = "Palhaço Assassino"
description = "A cada início de seu 3º turno (3º, 6º, 9º...), possui 50% de chance de invocar um “Guarda-Fantoche\"."
narrative_description = "A maquiagem exagerada escorre pelo rosto, misturando tinta com sangue seco. O enorme sorriso pintado nunca desaparece, mesmo quando ele afia lentamente a lâmina contra a própria roupa. Entre uma gargalhada e outra, ele parece genuinamente feliz por finalmente ter encontrado um novo público."
