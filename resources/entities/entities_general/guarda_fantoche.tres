[resource]
script = ExtResource("1_hp4v6")
id = &"en_00018"
display_name = "Guarda-Fantoche"
description = "A cada início de seu 3º turno (3º, 6º, 9º...), possui 50% de chance de invocar um “Palhaço Assassino\"."
narrative_description = "Vestidos como antigos guardas de parque de diversões, eles permanecem imóveis até perceberem a presença de vocês. Então, começam a caminhar em movimentos secos e desajeitados, carregando enormes martelos pintados com cores vibrantes. O único som é o estalar de suas articulações, como se alguém invisível estivesse manipulando enormes fantoches."
