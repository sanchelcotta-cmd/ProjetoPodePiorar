[resource]
script = ExtResource("1_p2gh8")
display_name = "A Experiência"
description = "Ao iniciar o Encontro e antes do combate, caso o grupo possua as Informações \"Orchestra 2/5\" e/ou \"Orchestra 3/5\", é possível tentar convencer A Experiência a se aliar ao grupo. 
• Se o grupo possuir apenas uma dessas Informações, a chance de sucesso é de 50%. 
• Se possuir ambas, a chance de sucesso é de 75%. 
Em caso de sucesso, A Experiência torna-se uma aliada.
Quantidade gerada por Encontro Aleatório: 1. Após ser derrotada, esta criatura não pode ser gerada novamente durante a partida.
"
narrative_description = "Partes do corpo parecem costuradas umas às outras sem qualquer lógica, músculos se contraem sob a pele de maneira desordenada e a criatura respira com dificuldade, como se cada segundo de existência fosse uma tortura. Ainda assim, seus olhos revelam algo inesperado: ela parece compreender exatamente quem vocês são."
vida_base = 60
ataque_base = 12
stamina_base = 6
maestrias = Array[int]([2])
skill_passivas = Array[ExtResource("2_gt8if")]([ExtResource("3_10312"), ExtResource("4_2xnj5"), ExtResource("5_8myhm")])
tags = Array[StringName]([&"core_orchestra", &"humanoide", &"especial", &"esquiva_30", &"ataque_extra", &"protecao_75", &"centro"])
metadata/_custom_type_script = "uid://8ma4cswg5n35"
