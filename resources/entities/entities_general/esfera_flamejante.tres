[resource]
script = ExtResource("1_7sv6k")
id = &"en_00014"
display_name = "Esfera Flamejante"
description = "Ao surgir, destrói e incendeia o bloco em que nasce, antes do início da ordem de iniciativa.
Após terminar seu movimento, destrói e incendeia o bloco que ocupa. Blocos incendiados permanecem inutilizados até o fim da Rodada, impedindo sua ativação, mesmo após o término do combate."
narrative_description = "Quando toca o chão, o impacto espalha labaredas em todas as direções, transformando ruas, carros e destroços em combustível. O calor é tão intenso que permanecer perto dela já parece uma péssima ideia."
