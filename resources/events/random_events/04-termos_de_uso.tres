[resource]
script = ExtResource("7_ckit5")
display_name = "Termos de Uso"
description = "Se o grupo não tiver nenhuma Informação do tipo \"Controle da Mente\", o evento invoca uma horda de zumbis dançarinos, em quantidade equivalente ao Distrito atual."
narrative_description = "Sem motivo algum, um celular começa a tocar uma música chiclete no meio da rua. Logo depois, outro toca. Depois mais um. Em poucos segundos, o som ecoa por toda a vizinhança. Um arrepio percorre sua espinha. Alguma coisa está prestes a acontecer..."
resolution_mode = 4
selection_weight = 2
outcomes = Array[ExtResource("1_1vepk")]([SubResource("Resource_pvbcc"), SubResource("Resource_r81tr")])
metadata/_custom_type_script = "uid://cos7c56kjihyx"
