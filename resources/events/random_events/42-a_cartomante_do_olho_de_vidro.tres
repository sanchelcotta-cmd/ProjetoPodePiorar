[sub_resource type="Resource" id="Outcome"]
script = ExtResource("2_outcome")
id = &"ev_00042_out_01"
display_name = "A cartomante mostra o futuro."
narrative_description = "A cartomante mostra o futuro.\nA cartomante te mostra o futuro, e três destinos aleatórios são revelados."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_reveal"), SubResource("Effect_warning")])

[resource]
script = ExtResource("1_event")
id = &"ev_00042"
display_name = "A Cartomante do Olho de Vidro"
description = "Revela 3 blocos aleatórios e avisa se há Catástrofe, Armadilha ou Maldição na Rodada, sem identificar o bloco."
narrative_description = "Sentada na varanda de uma casa velha, uma senhora embaralha um baralho gasto pelo tempo. Um dos olhos acompanha cada movimento seu. O outro, de vidro, mantém-se fixo ao baralho. Ela espalha três cartas sobre a mesa, suspira e aponta para três direções diferentes. Antes que você vá embora, ela sorri de canto."
valence = 0
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
