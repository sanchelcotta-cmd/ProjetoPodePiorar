[sub_resource type="Resource" id="Outcome"]
script = ExtResource("2_outcome")
id = &"ev_00041_out_01"
display_name = "O redemoinho refaz a linha inteira."
narrative_description = "Após a gargalhada desaparecer em eco... O redemoinho deixa um trilho de caos. Por uma linha reta, tudo mudou!"
effects = Array[ExtResource("3_effect")]([SubResource("Effect")])

[resource]
script = ExtResource("1_event")
id = &"ev_00041"
display_name = "Traquinagens do Saci"
description = "O redemoinho refaz todos os hexágonos da linha horizontal do bloco que ativou o evento, inclusive esse bloco e os já ativados. Blocos de Informação permanecem exatamente onde estavam, sem mudar de estado. Os demais recebem Resources que não estavam no mapa atual, embaralhados e sorteados sem repetição, ignorando cotas, valências, pesos e percentuais da geração normal. Os blocos substituídos voltam a ficar ocultos e podem ser ativados novamente."
narrative_description = "Um redemoinho atravessa a rua em disparada. Lá no meio, por um instante, você juraria ter visto um gorro vermelho. Ele deixou pelo caminho folhas, poeira e uma gargalhada estridente gravadas em sua memória."
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
