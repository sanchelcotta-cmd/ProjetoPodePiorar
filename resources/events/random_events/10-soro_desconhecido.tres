[resource]
script = ExtResource("6_q2apb")
display_name = "Soro Desconhecido"
description = "Um soro é encontrado. O jogador pode optar por usá-lo:
10% — Superpoder: dobra o Ataque e a Vida atual.
20% — Força: +2 de Ataque e +2 de Vida.
20% — Ganha imunidade a doenças.
30% — Fica doente (aplica o efeito de Doença).
20% — Era placebo. Nada acontece.
Se o jogador optar por não usar o soro, ele desaparece sem efeito."
narrative_description = "Uma maleta preta aberta no meio da calçada. Dentro dela, uma ampola quebrada e outra ainda cheia de um líquido verde que parece emitir luz própria. Não existe etiqueta, nem indicação do fabricante. Só uma seringa já preparada. A pergunta não é se isso é uma péssima ideia. A pergunta é... você teria coragem?"
resolution_mode = 3
selection_weight = 5
outcomes = Array[ExtResource("1_h6u4r")]([SubResource("Resource_r2c0b"), SubResource("Resource_cy88p"), SubResource("Resource_notf4"), SubResource("Resource_tj1s6"), SubResource("Resource_wpr3f")])
metadata/_custom_type_script = "uid://cos7c56kjihyx"
