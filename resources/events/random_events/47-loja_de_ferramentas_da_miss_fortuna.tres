[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://scripts/sc_resources/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/sc_resources/event_outcome_data.gd" id="2_outcome"]
[ext_resource type="Script" path="res://scripts/sc_resources/event_effect_data.gd" id="3_effect"]

[sub_resource type="Resource" id="Effect_item"]
script = ExtResource("3_effect")
effect_type = 10
selection_mode = 1
tags_filter = Array[StringName]([&"arma"])

[sub_resource type="Resource" id="Outcome"]
script = ExtResource("2_outcome")
display_name = "Escolha uma arma."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_item")])

[resource]
script = ExtResource("1_event")
display_name = "Loja de Ferramentas da Miss Fortuna"
description = "O jogador escolhe e obtém qualquer arma disponível no jogo."
narrative_description = "Uma pequena lojinha aparece onde, até alguns segundos atrás, não existia absolutamente nada. Na porta, uma plaquinha escrita à mão: 'Miss Fortuna'. Lá dentro, uma mulher elegante organiza armas de todos os tipos. Miss Fortuna limpa uma espada com um pano enquanto assovia baixinho. [fala_miss_fortuna]"
valence = 0
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
