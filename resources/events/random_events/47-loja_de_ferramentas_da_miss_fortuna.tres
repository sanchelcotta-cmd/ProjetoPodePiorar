[resource]
script = ExtResource("1_event")
id = &"ev_00047"
display_name = "Loja de Ferramentas da Miss Fortuna"
description = "O jogador escolhe e obtém qualquer arma disponível no jogo."
narrative_description = "Uma pequena lojinha aparece onde, até alguns segundos atrás, não existia absolutamente nada. Na porta, uma plaquinha escrita à mão: 'Miss Fortuna'. Lá dentro, uma mulher elegante. As prateleiras estão cobertas por armas de todos os tipos. Miss Fortuna limpa uma espada com um pano enquanto assovia baixinho.\n[fala_miss_fortuna]"
valence = 0
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
