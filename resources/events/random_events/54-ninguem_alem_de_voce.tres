[sub_resource type="Resource" id="Outcome"]
script = ExtResource("2_outcome")
id = &"ev_00054_out_01"
display_name = "Você fica sozinho."
narrative_description = "O grupo desaparece do mapa por seus próximos três turnos. Encontros Indesejados não ativam nesse período; depois, os companheiros retornam às posições de onde sumiram."
effects = Array[ExtResource("3_effect")]([SubResource("Effect")])

[resource]
script = ExtResource("1_event")
id = &"ev_00054"
display_name = "Ninguém Além de Você"
description = "Por 3 turnos, só o personagem ativo permanece no mapa. Encontros Indesejados não ativam; depois, o grupo retorna às posições originais."
narrative_description = "Você finalmente conseguiu alguns minutos de paz. Seus companheiros desapareceram, e curiosamente, não há mais nenhuma criatura perigosa à espreita. Curta enquanto dura. Coachs motivacionais chamariam isso de 'tempo de qualidade consigo mesmo', mas você chama de 'estranho pra caramba'."
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
custom_rule = &"solo_active_entity_for_three_turns"
