[resource]
script = ExtResource("2_uqagm")
id = &"ev_00003"
display_name = "O Velho Louco"
description = "Se o grupo não tiver nenhuma Informação do tipo \"Homens de Preto\", o velho se transforma em um inimigo e ataca o grupo.

Atributos randomizados: a Vida e o Ataque partem, cada um, da média dos respectivos atributos de todo o grupo, incluindo aliados. Cada atributo recebe um desvio sorteado independentemente entre -5 e +5 pontos (inclusive valores intermediários).
"
narrative_description = "Tem um velho esquisito, no canto da esquina. A aba do chapéu cobre metade da sua face, mas, mesmo meio de longe dá pra notar um olhão esbugalhado em sua direção. Ele parece querer analisar se vocês sabem o que ele sabe."
resolution_mode = 4
selection_weight = 2
outcomes = Array[ExtResource("1_bxfxi")]([SubResource("Resource_pvbcc"), SubResource("Resource_r81tr")])
custom_rule = &"start_crazy_old_man_combat_scaled_to_group"
tags = Array[StringName]([&"homens_de_preto", &"combat", &"script_personalizado", &"somente_campanha_completa"])
metadata/_custom_type_script = "uid://cos7c56kjihyx"
