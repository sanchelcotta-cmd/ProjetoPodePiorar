[resource]
script = ExtResource("1_event")
id = &"ev_00031"
display_name = "Portal Mágico"
description = "O personagem ativo pode ir para um novo mapa de distrito aleatório, mantendo o Dia e a Rodada. Nenhum bloco é ativado na chegada."
narrative_description = "Você escuta o som de correntes e um bolo de chaves. No instante seguinte, um portal se abre bem na sua frente. Brilhando em um azul bonito de se ver. Do outro lado, existe um lugar... E algo parece te chamar para atravessar."
