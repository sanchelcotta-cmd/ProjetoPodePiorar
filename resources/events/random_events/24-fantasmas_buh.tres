[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://scripts/sc_resources/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/sc_resources/event_outcome_data.gd" id="2_outcome"]
[ext_resource type="Script" path="res://scripts/sc_resources/event_effect_data.gd" id="3_effect"]

[sub_resource type="Resource" id="Effect_good"]
script = ExtResource("3_effect")
effect_type = 12
selection_mode = 2

[sub_resource type="Resource" id="Effect_bad"]
script = ExtResource("3_effect")
effect_type = 28
custom_rule = &"fantasmas_do_mal"

[sub_resource type="Resource" id="Outcome_good"]
script = ExtResource("2_outcome")
display_name = "Fantasmas do Bem"
narrative_description = "Um fantasma atravessa você e deixa um embrulho cair no chão. Antes que dê tempo de agradecer, ele desaparece dando uma risadinha."
weight = 30
effects = Array[ExtResource("3_effect")]([SubResource("Effect_good")])

[sub_resource type="Resource" id="Outcome_bad"]
script = ExtResource("2_outcome")
display_name = "Fantasmas do Mal"
narrative_description = "Eles aparecem sem fazer barulho. O grito vem depois. Quando tudo acaba, o frio continua aí."
weight = 70
effects = Array[ExtResource("3_effect")]([SubResource("Effect_bad")])

[resource]
script = ExtResource("1_event")
display_name = "Fantasmas BUH!"
description = "Fantasmas do bem oferecem um item aleatório (30%). Fantasmas do mal causam 2 de dano em todos e aplicam Terror por 1d4 turnos (70%)."
resolution_mode = 1
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome_good"), SubResource("Outcome_bad")])
