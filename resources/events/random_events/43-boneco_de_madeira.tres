[resource]
script = ExtResource("1_event")
id = &"ev_00043"
display_name = "Boneco de Madeira"
description = "Um boneco segue seu dono pelo mapa e cancela a primeira Armadilha ou Catástrofe ruim que ele alcançar. Após o OK da confirmação, o bloco é destruído e o boneco desaparece."
narrative_description = "Esquecido no chão, um pequeno boneco de madeira começa a mexer os dedos assim que você se aproxima. Ele se levanta devagar, bate a poeira do próprio ombro e passa a seguir você por todo canto. Nunca fala. Nunca reclama. Só imita exatamente tudo o que você faz."
valence = 0
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
custom_rule = &"add_wooden_doll_companion"
