[sub_resource type="Resource" id="Effect_attack"]
script = ExtResource("3_effect")
effect_type = 30
event_id = &"ev_00021"

[sub_resource type="Resource" id="Outcome_attack"]
script = ExtResource("2_outcome")
id = &"ev_00020_out_01"
display_name = "Ataque Sobrenatural"
narrative_description = "Escondido entre os escombros, existe um objeto que não parece pertencer a esse mundo. Assim que você o toca, alguma coisa responde. Um arranhão horrível sobe pelas suas costas... Você nunca mais se sentirá inteiro de novo."
weight = 35
effects = Array[ExtResource("3_effect")]([SubResource("Effect_attack")])

[sub_resource type="Resource" id="Effect_persecution"]
script = ExtResource("3_effect")
effect_type = 30
event_id = &"ev_00022"

[sub_resource type="Resource" id="Outcome_persecution"]
script = ExtResource("2_outcome")
id = &"ev_00020_out_02"
display_name = "Perseguição Sobrenatural"
narrative_description = "Quando você olha para trás, não tem ninguém. Mas ao olhar pra frente, sente um puxão no pé. Se você olhar novamente, não verá ninguém. Mas da próxima, o puxão será mais forte... E ele virá."
weight = 35
effects = Array[ExtResource("3_effect")]([SubResource("Effect_persecution")])

[sub_resource type="Resource" id="Effect_taming"]
script = ExtResource("3_effect")
effect_type = 30
event_id = &"ev_00023"

[sub_resource type="Resource" id="Outcome_taming"]
script = ExtResource("2_outcome")
id = &"ev_00020_out_03"
display_name = "Adestramento Sobrenatural"
narrative_description = "Você percebe [criatura_sorteada]. Ela também te notou. Você se prepara para correr... Mas a criatura apenas inclina a cabeça, como se finalmente tivesse reconhecido seu dono. Alguns monstros só precisavam de um bom dono."
weight = 30
effects = Array[ExtResource("3_effect")]([SubResource("Effect_taming")])

[resource]
script = ExtResource("1_event")
id = &"ev_00020"
display_name = "Um Artefato Mágico"
description = "Um artefato de origem incerta sorteia um efeito sobrenatural: Ataque (35%), Perseguição (35%) ou Adestramento (30%)."
resolution_mode = 1
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome_attack"), SubResource("Outcome_persecution"), SubResource("Outcome_taming")])
