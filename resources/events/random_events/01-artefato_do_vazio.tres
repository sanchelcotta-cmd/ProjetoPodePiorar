[resource]
script = ExtResource("2_gvv41")
id = &"ev_00001"
tags = Array[StringName]([&"somente_campanha_completa"])
display_name = "Artefato do Vazio"
description = "Se o grupo não tiver nenhuma Informação do tipo \"Khainokata\", todos os personagens perdem metade da vida máxima."
narrative_description = "A esfera parece pequena, mas quanto mais olha, menos consegue dizer o tamanho dela. O roxo pulsa sem emitir luz nenhuma, como se estivesse roubando a cor do mundo. Dá uma impressão estranha... como se ela estivesse lembrando de você... Ela gira lentamente, e parece encarar você – ou, talvez, sua alma."
resolution_mode = 4
outcomes = Array[ExtResource("1_kbo8m")]([SubResource("Resource_wlutp"), SubResource("Resource_hen2t")])
metadata/_custom_type_script = "uid://cos7c56kjihyx"
