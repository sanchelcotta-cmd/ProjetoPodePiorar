[resource]
script = ExtResource("1_event")
id = &"gn_00001"
display_name = "Gnomo Misterioso"
description = "Um raio atinge um personagem aleatório: 25% de dobrar Ataque e Vida atuais, 25% de permitir movimento livre pelo mapa, 25% de conceder 60% de Esquiva em combate, ou 25% de causar o dobro de 1d6 de dano."
narrative_description = "O gnomo aponta para o céu com um sorriso orgulhoso. Uma nuvem que não estava ali pisca em resposta."
resolution_mode = 1
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome_force"), SubResource("Outcome_teleport"), SubResource("Outcome_agility"), SubResource("Outcome_damage")])
tags = Array[StringName]([&"gnomes_3", &"lightning", &"random_character"])
