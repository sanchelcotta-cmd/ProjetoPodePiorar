[resource]
script = ExtResource("1_event")
id = &"ev_00036"
display_name = "Terremoto"
description = "Revela todo o mapa. Cada personagem perde 1d6 de Vida; quem tirar 6 perde também o próximo turno."
narrative_description = "Vocês estão andando, quando o chão inteiro começa a rugir. Tá tudo tremendo como se tivesse na velocidade vezes dois. Depois que tudo para, nada continua escondido, e nem todo mundo saiu inteiro."
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
