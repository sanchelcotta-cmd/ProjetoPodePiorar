[resource]
script = ExtResource("2_3o5oy")
id = &"ev_00007"
display_name = "Gnomos do Caos"
description = "Os gnomos transformam aleatoriamente todos os itens carregados pelos jogáveis e todos os equipamentos vestidos pelo grupo, inclusive aliados. Equipados continuam no mesmo tipo de slot; os itens carregados podem ser remanejados entre jogáveis para caber. Se ainda faltar espaço, uma mochila indispensável permanece e muda para outro jogável, remanejando o acessório dele. Nenhum item se perde por falta de capacidade. Itens básicos podem virar Épicos e vice-versa, mas, se havia ao menos um Épico entre os itens afetados, ao menos um Épico retorna. Maldições existentes podem desaparecer na troca; nenhuma Maldição nova é sorteada."
narrative_description = "Vocês percebem a coisinha minúscula, de corpo redondo, olhos grandes e chapéu pontudo. Ele tropeça na própria barba, chuta uma pedrinha, se levanta e te encara. Nessa hora, você sente que algo não tá normal... E aquele gnomo parece muito satisfeito com a qualidade da própria bagunça."
outcomes = Array[ExtResource("1_7yb0k")]([SubResource("Resource_tem3e")])
metadata/_custom_type_script = "uid://cos7c56kjihyx"
