[resource]
script = ExtResource("2_3o5oy")
display_name = "Gnomos do Caos"
description = "Os gnomos transformam todos os itens do inventário de todos os personagens em itens completamente aleatórios — inclusive trocando itens básicos por épicos, e vice-versa."
narrative_description = "Vocês percebem a coisinha minúscula, de corpo redondo, olhos grandes e chapéu pontudo. Ele tropeça na própria barba, chuta uma pedrinha, se levanta e te encara. Nessa hora, você sente que algo não tá normal... E aquele gnomo parece muito satisfeito com a qualidade da própria bagunça."
outcomes = Array[ExtResource("1_7yb0k")]([SubResource("Resource_tem3e")])
