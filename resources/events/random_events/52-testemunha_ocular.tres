[resource]
script = ExtResource("1_event")
id = &"ev_00052"
display_name = "Testemunha Ocular"
description = "O personagem ativo sofre Terror até o fim da Rodada apenas na primeira ocorrência deste evento para ele na campanha."
narrative_description = "No fim da rua existe uma mesa de xadrez. Uma capivara com tentáculos encara um alienígena completamente sério. Em volta, goblins assistem em silêncio absoluto. A capivara anuncia um xeque-mate. Antes que você entenda qualquer coisa, ela simplesmente engole o extraterrestre inteiro. Quando você olha para os lados, ninguém mais parece ter visto aquilo... Contar isso para os outros não vai ser fácil."
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
