display_name = "O Informante"
description = "Um informante oferece uma Informação aleatória, mas em troca, o personagem ativo perde 5 pontos de vida máxima permanente."
narrative_description = "É um cara de sobretudo cáqui, chapéu e cachimbo. Encostado à sombra de uma entrada daquele beco... Ao trocar olhares com [personagem_ativo], ele sopra fumaça e acena levemente. Antes mesmo de você chegar perto, ele já estende a mão, esperando alguma coisa em troca."
resolution_mode = 2
outcomes = Array[ExtResource("1_5qnyl")]([SubResource("Resource_su5xn"), SubResource("Resource_gfnhu")])
metadata/_custom_type_script = "uid://cos7c56kjihyx"
