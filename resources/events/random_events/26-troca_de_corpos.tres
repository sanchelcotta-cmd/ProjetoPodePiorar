[resource]
script = ExtResource("1_event")
id = &"ev_00026"
display_name = "Troca de Corpos"
description = "Os jogáveis ativos trocam em rodízio apenas o nome e a aparência (sprites, animações e retratos). Atributos, Maestrias, habilidades, equipamentos, inventários e posições permanecem com seus donos. Companheiros não participam. Se o evento se repetir, a troca visual é revertida."
narrative_description = "Você pisca. Todo mundo parece... diferente. A voz não combina com o rosto. As mãos também não parecem suas. Pelo menos o desespero continua compartilhado."
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
