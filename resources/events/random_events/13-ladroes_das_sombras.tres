[resource]
script = ExtResource("3_vmvyo")
id = &"ev_00013"
display_name = "Ladrão das Sombras"
description = "Cada personagem do grupo perde um item, sorteado individualmente com as mesmas probabilidades:
25% — A arma equipada.
25% — A armadura equipada.
25% — O acessório equipado.
25% — Um item do inventário.
Este afeta todos os personagens do grupo."
narrative_description = "Todo mundo sente um arrepio subindo da pontinha do dedinho do pé, até a nuca. Ao longe, uma gargalhada. Vinda daquele telhado? E então, vocês perderam... Cada um, algo que carregava."
valence = 2
resolution_mode = 1
selection_weight = 4
outcomes = Array[ExtResource("1_5p0qe")]([SubResource("Resource_poudy"), SubResource("Resource_ytt3h"), SubResource("Resource_jp7xl"), SubResource("Resource_t8s38")])
metadata/_custom_type_script = "uid://cos7c56kjihyx"
