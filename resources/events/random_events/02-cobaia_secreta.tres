[resource]
script = ExtResource("6_olx2i")
display_name = "Cobaia Secreta"
description = "Se o grupo não tiver nenhuma Informação do tipo \"Orchestra\", o personagem ativo descobre a Informação #4 da Orchestra.
Ao mesmo tempo, sofre os efeitos de Doença e Tristeza, ao relembrar que já foi uma das cobaias do experimento.
"
narrative_description = "Você trava ao perceber uma folha amarelada rebatendo em um arbusto próximo. A palavra “Confidencial” salta. Aquele papel não deveria estar ali, em meio à rua. Mas você sabe agora... Sem precisar ler nada – você já esteve lá."
resolution_mode = 4
outcomes = Array[ExtResource("1_36hgb")]([SubResource("Resource_wlutp"), SubResource("Resource_hen2t")])
metadata/_custom_type_script = "uid://cos7c56kjihyx"
