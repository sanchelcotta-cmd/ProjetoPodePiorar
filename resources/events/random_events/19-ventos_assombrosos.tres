[resource]
script = ExtResource("2_bbxnr")
id = &"ev_00019"
display_name = "Ventos Assombrosos"
description = "Pelos próximos 2 turnos, todos os personagens perdem -2 de Estamina. Há 50% de chance de o evento também causar Terror em todos."
narrative_description = "O vento começa fraco, mas logo parece atravessar seu corpo inteiro. Cada passo fica mais pesado. O vento agora assobia... Aquela música assustadora. Sim. Aquela mesma. (-- nossos advogados pediram para não especificar qual.)"
valence = 2
resolution_mode = 1
outcomes = Array[ExtResource("1_4v3tx")]([SubResource("Outcome_wind"), SubResource("Outcome_terror")])
