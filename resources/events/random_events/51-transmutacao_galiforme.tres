[sub_resource type="Resource" id="Outcome"]
script = ExtResource("2_outcome")
id = &"ev_00051_out_01"
display_name = "Você vira uma galinha."
narrative_description = "Por enquanto, o mundo verá uma galinha azulada onde você estava. Até o fim desta Rodada, sua aparência muda, mas Vida, Ataque, Estamina, itens, Maestrias e habilidades permanecem intactos."
effects = Array[ExtResource("3_effect")]([SubResource("Effect")])

[resource]
script = ExtResource("1_event")
id = &"ev_00051"
display_name = "Transmutação Galiforme"
description = "Até o fim da Rodada, o personagem ativo tem aparência de galinha; atributos, itens, Maestrias e passivas não mudam."
narrative_description = "[personagem_ativo] sente um arrepio subir da ponta dos pés até o topo da cabeça. As mãos desaparecem. Um bico surge onde deveria haver um nariz. Algumas penas depois, e uma vontade irresistível de ciscar. Então, resta apenas um sonoro: 'Pó... pó... pó...?'."
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
