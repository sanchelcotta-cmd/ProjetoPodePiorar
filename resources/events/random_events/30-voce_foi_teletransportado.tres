[resource]
script = ExtResource("1_event")
id = &"ev_00030"
display_name = "Você Foi Teletransportado"
description = "O personagem ativo é levado a outro bloco aleatório do mapa atual e ativa imediatamente o efeito desse bloco."
narrative_description = "Primeiro você sente como se sua pele fosse esticada até um poste. Depois sente os órgãos se encolhendo e um gosto agridoce subindo pela garganta. Tem cheiro de azeitonas. Mas antes de conseguir pensar no porquê... tudo mudou. Quando percebe seus pés tocando o chão novamente, você já não está mais no mesmo lugar."
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
