[resource]
script = ExtResource("3_soki4")
id = &"ev_00009"
display_name = "Gnomos do Caos"
description = "Até 5 Gnomos Misteriosos ocupam hexágonos ocultos que não contêm Informação. Cada um tem uma cor, embaralhada entre os efeitos a cada surgimento; a cor não identifica o resultado. Ao parar sobre um deles, seu efeito substitui o conteúdo anterior do hex. Após 3 gnomos ativados, os restantes desaparecem."
narrative_description = "Cinco chapéus pontudos e coloridos se espalham pelo mapa. Um dos gnomos acena. Outro parece cochichar com uma pedra. Um terceiro enterra alguma coisa e começa a assobiar como se nada estivesse acontecendo."
outcomes = Array[ExtResource("1_qp440")]([SubResource("Resource_pa87y")])
generated_events = Array[ExtResource("3_soki4")]([ExtResource("4_gnome_1"), ExtResource("5_gnome_2"), ExtResource("6_gnome_3"), ExtResource("7_gnome_4"), ExtResource("8_gnome_5")])
custom_rule = &"spawn_gnomes_3"
tags = Array[StringName]([&"gnomes_3", &"script_personalizado"])
metadata/_custom_type_script = "uid://cos7c56kjihyx"
