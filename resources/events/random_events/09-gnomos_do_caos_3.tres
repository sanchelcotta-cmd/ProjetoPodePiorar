[resource]
script = ExtResource("3_soki4")
display_name = "Gnomos do Caos"
description = "Gnomos se posicionam pelo mapa. Existem 5 Gnomos Misteriosos, visualmente indistinguíveis entre si. Chegar a um deles substitui o efeito do bloco, revelado apenas ao parar sobre ele. Após 3 gnomos serem ativados, todos os restantes desaparecem."
narrative_description = "Cinco chapéus pontudos espalhados pelo mapa, todos iguais, todos imóveis... até você chegar perto. Um deles acena. Outro parece estar cochichando com uma pedra. Um terceiro enterra alguma coisa e começa a assobiar como se nada estivesse acontecendo."
outcomes = Array[ExtResource("1_qp440")]([SubResource("Resource_pa87y")])
custom_rule = &"spawm_gnomes"
tags = Array[StringName]([&"gnomes_3"])
metadata/_custom_type_script = "uid://cos7c56kjihyx"
