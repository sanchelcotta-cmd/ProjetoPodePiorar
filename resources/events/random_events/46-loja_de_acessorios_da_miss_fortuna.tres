[resource]
script = ExtResource("1_event")
id = &"ev_00046"
display_name = "Loja de Acessórios da Miss Fortuna"
description = "O jogador escolhe e obtém qualquer acessório disponível no jogo."
narrative_description = "Uma pequena lojinha aparece onde, até alguns segundos atrás, não existia absolutamente nada. Na porta, uma plaquinha escrita à mão: 'Miss Fortuna'. Lá dentro, uma mulher elegante organiza dezenas de acessórios sobre uma bancada de madeira. Sem sequer levantar a cabeça, ela diz:\n[fala_miss_fortuna]"
valence = 0
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
