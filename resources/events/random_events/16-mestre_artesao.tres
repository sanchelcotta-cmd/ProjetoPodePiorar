[resource]
script = ExtResource("2_72u7j")
display_name = "Mestre Artesão"
description = "O jogador escolhe um item equipado (arma ou armadura) e adiciona o resultado de um dado de 6 lados ao seu valor de Ataque (se arma) ou de Vida (se armadura)."
narrative_description = "Um velho de barba comprida segura [sem item] como quem já viu milhares iguais. Sem dizer uma única palavra, ele bate nela algumas vezes com um martelo, devolve o equipamento e vai embora...
(Se for roupa/vestimenta):
“... Meio estranho martelar uma roupa. Mas ela parece... melhor.\"
(Se for arma):
Ela parece... melhor.\"
"
valence = 0
outcomes = Array[ExtResource("1_07v3h")]([SubResource("Resource_q72j0")])
