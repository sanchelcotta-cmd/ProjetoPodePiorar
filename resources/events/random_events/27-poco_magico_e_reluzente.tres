[resource]
script = ExtResource("1_event")
id = &"ev_00027"
display_name = "Poço Mágico e Reluzente"
description = "O personagem ativo pode beber do poço e sortear uma alteração de Vida máxima e/ou Ataque. A Vida atual não sobe ao ganhar Vida máxima e só cai se ultrapassar o novo limite."
narrative_description = "No fundo do poço, a água brilha como se escondesse um pedaço do céu. A superfície reflete uma versão sua que sorri primeiro. Vai beber mesmo assim?"
resolution_mode = 3
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome_hp_to_attack"), SubResource("Outcome_attack_to_hp"), SubResource("Outcome_hp"), SubResource("Outcome_attack"), SubResource("Outcome_both")])
