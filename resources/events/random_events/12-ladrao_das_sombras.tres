[resource]
script = ExtResource("2_32v2x")
id = &"ev_00012"
display_name = "Ladrão das Sombras"
description = "Um ladrão furta o personagem ativo. Sorteia-se um dos itens abaixo para ser perdido:
25% — A arma equipada.
25% — A armadura equipada.
25% — O acessório equipado.
25% — Um item do inventário.
Este evento afeta apenas o personagem ativo."
narrative_description = "Você só percebeu que foi roubado quando se sentiu mais leve.. Olhou pro lado, pro outro, e quase viu uma mão acenando. Ao olhar de volta, você percebe a falta de [item perdido]"
valence = 2
resolution_mode = 1
selection_weight = 4
outcomes = Array[ExtResource("1_15cqp")]([SubResource("Resource_poudy"), SubResource("Resource_ytt3h"), SubResource("Resource_jp7xl"), SubResource("Resource_t8s38")])
metadata/_custom_type_script = "uid://cos7c56kjihyx"
