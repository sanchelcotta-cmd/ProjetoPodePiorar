[resource]
script = ExtResource("2_r5idj")
display_name = "Artefato Misterioso"
description = "O jogador encontra um artefato de origem incerta. Sorteia-se um dos três efeitos abaixo:
35% — Ataque Sobrenatural: perde 5 pontos de Vida permanentemente.
35% — Perseguição Sobrenatural: um fantasma amaldiçoa o personagem; por um Dia inteiro, sofre -2 de dano na Vida sempre que for seu turno.
30% — Adestramento Sobrenatural: um inimigo aleatório do Distrito atual se transforma em um aliado extra.
"
resolution_mode = 1
selection_weight = 3
