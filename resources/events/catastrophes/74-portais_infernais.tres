[sub_resource type="Resource" id="Outcome"]
script = ExtResource("2_outcome")
id = &"ev_00074_out_01"
id = &"ev_00074_out_01"
display_name = "Portais se abrem pelo mapa."
narrative_description = "Portais se abrem pelo mapa.\nDurante a Rodada, ao chegar ao bloco de destino do movimento, você poderá sofrer dano por queimadura!"
effects = Array[ExtResource("3_effect")]([SubResource("Effect")])

[resource]
script = ExtResource("1_event")
id = &"ev_00074"
display_name = "Portais Infernais"
description = "Durante a Rodada, ao chegar ao bloco de destino do movimento, cada personagem tem 30% de chance de sofrer 1d6 de dano por uma esfera flamejante."
narrative_description = "Pequenas rachaduras de fogo começam a surgir pelo chão. Elas aparecem por um segundo... e desaparecem logo depois. De vez em quando, alguma resolve cuspir uma bola de fogo. Ninguém parece saber quando será a próxima."
category = 2
valence = 2
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
tags = Array[StringName]([&"catastrophe", &"movement", &"damage", &"round_duration"])
