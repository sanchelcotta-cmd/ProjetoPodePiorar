[resource]
script = ExtResource("1_event")
id = &"ev_00077"
display_name = "Minas Explosivas"
description = "Causa 1d6 de dano e Queimadura no hex ativado e em seus seis hexágonos vizinhos. A Queimadura começa com o mesmo valor do dado e diminui 1 de dano por turno até zerar."
narrative_description = "Um clique metálico quase tímido soa sob seu pé. Então o chão decide responder em voz alta."
category = 3
valence = 2
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
tags = Array[StringName]([&"trap", &"damage", &"burn", &"area_hex", &"dice"])
