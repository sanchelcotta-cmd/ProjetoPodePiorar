[resource]
script = ExtResource("1_event")
id = &"ev_00060"
display_name = "Áurea Milagrosa"
description = "Concede imunidade a Doença, Tristeza, Terror e Maldições."
narrative_description = "Uma memória vem à sua mente, como um lampejo. Era sua vó, na janela de madeira azulada, levantando a mão com um paninho de prato, enquanto evocava uma benção. E então, do nada, você percebe pequenos anjinhos dourados voando acima de sua cabeça."
