[resource]
script = ExtResource("1_event")
id = &"ev_00059"
display_name = "Pele Endurecida"
description = "Concede imunidade a Sangramento e Atordoamento. Contra críticos de Maestria Distância, mantém a redução de dano pela distância ao alvo."
narrative_description = "Você acaba tropeçando numa placa. Arqueia a sobrancelha quando percebe que ela entortou. Os outros te olham confusos. Meio sem entender, você sente seu corpo mais pesado. É como se sua pele tivesse decidido não ser mais pele... e sim alguma coisa muito mais dura."
category = 1
valence = 0
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
tags = Array[StringName]([&"permanent_effect", &"immunity", &"defense"])
