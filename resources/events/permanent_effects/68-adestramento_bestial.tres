[resource]
script = ExtResource("1_event")
id = &"ev_00068"
display_name = "Adestramento Bestial"
description = "Em combate, permite tentar adestrar um inimigo-alvo com 50% de chance. Sucesso concede um aliado; falha bloqueia a tentativa somente naquele combate."
narrative_description = "Você encontra um borrifador de plástico meio transparente. Dentro dele, um líquido brilhante balança devagar, como se fosse mais pesado que água. O rótulo diz apenas: 'Adestramento'. Você não sabe quem fez aquilo, mas tem certeza de que consegue dominar qualquer coisa com isso. Ou pelo menos, tentar."
category = 1
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
tags = Array[StringName]([&"permanent_effect", &"combat", &"taming"])
