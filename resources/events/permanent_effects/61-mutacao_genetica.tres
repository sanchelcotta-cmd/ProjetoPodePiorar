[resource]
script = ExtResource("1_event")
id = &"ev_00061"
display_name = "Mutação Genética"
description = "Escolhe um inimigo do último Encontro e soma seus valores base de Vida máxima e Ataque aos do personagem, além de receber suas Maestrias e Passivas."
narrative_description = "Você passa por uma vitrine e vê alguma coisa estranha no reflexo. Não é exatamente você. Também não é exatamente o último inimigo que enfrentaram. Mas basta olhar duas vezes para perceber que é um pouco dos dois."
