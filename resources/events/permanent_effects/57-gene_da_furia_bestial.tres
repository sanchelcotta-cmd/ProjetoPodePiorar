[resource]
script = ExtResource("1_event")
id = &"ev_00057"
display_name = "Gene da Fúria Bestial"
description = "Dobra a Vida máxima sem alterar a Vida atual e dobra o Ataque. Em combate com arma corpo a corpo, o Ataque recebe +50% arredondado para cima; sem arma, o Ataque final é triplicado."
narrative_description = "Um cachorro abandonado para no meio da rua e rosna para você. Você rosna de volta. Não sabe nem o porquê, mas rosna. O cachorro abaixa a cabeça e vai embora. Você demora um pouco mais para lembrar como se fala."
category = 1
valence = 0
can_repeat = false
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
tags = Array[StringName]([&"permanent_effect", &"health", &"attack"])
