display_name = "A fúria desperta."
narrative_description = "A fúria desperta.\nA partir de agora: sua Vida máxima e seu Ataque dobram. Em combate com arma corpo a corpo, o Ataque recebe mais força; se atacar sem arma, o Ataque final é triplicado."
