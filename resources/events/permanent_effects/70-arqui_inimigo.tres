[resource]
script = ExtResource("1_event")
id = &"ev_00070"
display_name = "Arqui-Inimigo"
description = "O personagem pode declarar um tipo de inimigo de Encontro Indesejado como arqui-inimigo. Ele causa dano dobrado a todos os inimigos daquele EntityData e recebe dano dobrado deles; a escolha é permanente."
narrative_description = "Você encontra um caderno velho. Todas as páginas estão em branco, menos uma. No topo dela está escrito: 'Lista de Inimigos'. O resto da folha espera, pacientemente, pelo primeiro nome."
category = 1
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
tags = Array[StringName]([&"permanent_effect", &"combat", &"archenemy"])
