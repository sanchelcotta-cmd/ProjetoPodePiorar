[resource]
script = ExtResource("1_event")
id = &"ev_00063"
display_name = "Doguinho Caramelo"
description = "Adiciona o Doguinho Caramelo como companheiro: 20 de Vida, 4 de Ataque corpo-a-corpo e a ativa Vai Pegar!, exibida na caixa complementar do companheiro vinculada a quem o recrutou."
narrative_description = "Você escuta patinhas correndo atrás de você. Quando olha para trás, um Doguinho caramelo já está ali, abanando o rabo como se finalmente tivesse encontrado quem procurava. Ninguém sabe de onde ele veio, mas por um ou dois petiscos, ele parece disposto a permanecer com vocês."
