[resource]
script = ExtResource("1_event")
id = &"ev_00058"
display_name = "Simbiose Elemental"
description = "Absorve primeiro uma arma Épica equipada ou, se não houver, uma Épica sorteada da mochila. Sem Épica, absorve a arma comum equipada ou sorteia uma comum da mochila e a evolui para uma versão Épica. Sem nenhuma arma, o efeito é inválido. A arma absorvida ocupa o slot permanentemente e não pode ser trocada. Preserva passivas, Maestria e bônus da versão Épica. Distância ignora o limite de alcance e a redução de dano pelos hexes até o alvo; Lâmina causa Sangramento e Impacto causa Atordoamento em todo ataque que causar dano."
narrative_description = "Você apoia a mão sobre sua arma por um instante. Quando tenta pegá-la de volta... ela já não está mais ali. Desesperado, você procura no chão, na mochila, ao redor. Só então percebe o peso diferente no próprio braço. Sem nenhuma explicação, a arma agora faz parte de você... para sempre?"
category = 1
valence = 0
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
tags = Array[StringName]([&"permanent_effect", &"epic_equipment", &"mastery"])
