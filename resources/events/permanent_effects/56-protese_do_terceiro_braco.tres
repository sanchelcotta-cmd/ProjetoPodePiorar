[resource]
script = ExtResource("1_event")
id = &"ev_00056"
display_name = "Prótese do Terceiro Braço"
description = "O jogador escolhe uma Maestria: recebe a nova Maestria ou +1 se já a possui. O personagem ganha um slot extra para arma e um ataque extra por turno de combate."
narrative_description = "Você está andando numa boa, até que vê, se arrastando pelo chão, uma mão metálica. Ela não tem olhos, mas, se tivesse, estaria te encarando — e você sabe bem disso. A certeza vem quando a mão salta na sua direção e gruda no seu corpo. Ela simplesmente fica ali... Como se sempre tivesse pertencido a você."
category = 1
valence = 0
can_repeat = false
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
tags = Array[StringName]([&"permanent_effect", &"mastery", &"extra_attack"])
