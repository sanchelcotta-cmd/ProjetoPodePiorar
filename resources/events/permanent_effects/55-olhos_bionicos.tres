[sub_resource type="Resource" id="Outcome"]
script = ExtResource("2_outcome")
id = &"ev_00055_out_01"
id = &"ev_00055_out_01"
display_name = "Visão ampliada."
narrative_description = "Visão ampliada.\nA partir de agora: uma vez por turno, você pode revelar o tipo de um bloco ao alcance da Estamina. Recebe Maestria em Distância ou +1 se já a possuir, e ignora o limite de alcance em ataques à distância."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_active"), SubResource("Effect_passive")])

[resource]
script = ExtResource("1_event")
id = &"ev_00055"
display_name = "Olhos Biônicos"
description = "Uma vez por turno, permite revelar o tipo de um bloco ao alcance da Estamina. Concede Maestria em Distância ou +1 se já a possuir, e ignora o limite de alcance em ataques à distância."
narrative_description = "Você passa a mão nos olhos por causa de um cisco que nem existia. Quando abre de novo, enxerga uma moeda esquecida do outro lado da rua. Depois uma rachadura numa janela lá na frente. Depois uma formiga carregando uma folha, tão longe que nem faz sentido. Você pisca. Tem certeza de que ouviu um pequeno 'clic' vindo dos próprios olhos."
category = 1
valence = 0
can_repeat = false
outcomes = Array[ExtResource("2_outcome")]([SubResource("Outcome")])
tags = Array[StringName]([&"permanent_effect", &"reveal", &"ranged_mastery"])
