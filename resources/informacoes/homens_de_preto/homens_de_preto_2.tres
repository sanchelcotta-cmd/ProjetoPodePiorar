[resource]
script = ExtResource("1_smg6c")
id = &"in_00007"
titulo = "Homens de Preto - Parte 2"
descricao = "Qualquer um que visitava a casa de Dionísio se via obrigado a desviar de caixas e caixas cheias de papéis, recortes, gravações, livros. O homem colecionava padrões que ninguém mais parecia perceber. Anotava desaparecimentos, ou sumiços repentinos nos quais as pessoas retornavam dias depois, agindo com uma desconfortável normalidade. Nas anotações de Dionísio, algumas perguntas se destacavam:
\"Por que apagar memórias?\"
\"Qual o interesse dos homens de preto?\"
\"Por que o jornal local publica sobre uma capivara na primeira página?\""
tipo = 2
numero = 2
tags = Array[StringName]([&"informacao", &"homens_de_preto"])
metadata/_custom_type_script = "uid://cmesj3xfmjv7o"
