[resource]
script = ExtResource("1_cwie6")
id = &"in_00004"
titulo = "Controle da Mente - Parte 4"
descricao = "Enrico conseguiu acessar parte do código-fonte do aplicativo. Descobriu que ele não havia sido desenvolvido por uma empresa comum. Trechos inteiros do programa pareciam se reescrever, enquanto mensagens ocultas surgiam sempre que alguém tentava modificar seus arquivos. A linha que mais se repetia dizia:

\"Os termos são irrevogáveis.\"
Enrico percebeu que aquilo não era um simples programa, mas um instrumento criado para servir a uma inteligência desconhecida."
tipo = 3
numero = 4
tags = Array[StringName]([&"informacao", &"controle_da_mente"])
metadata/_custom_type_script = "uid://cmesj3xfmjv7o"
