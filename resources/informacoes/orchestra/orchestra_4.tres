script = ExtResource("1_caik6")
id = &"in_00019"
titulo = "Orchestra - Parte 4"
descricao = "Algumas pessoas começaram a desaparecer, deixando para trás apenas bilhetes dizendo que iriam para outra cidade. Os motivos eram diversos: 

\"Acho Belacidade chata\"
\"Quero me aventurar\"
\"Vou encontrar um crush\"
As pessoas retornavam dias depois, sem qualquer lembrança dos dias em que estiveram fora. Todas elas tinham algo em comum, carregavam cicatrizes inexplicáveis, e alguns comportamentos estranhos. Outra coincidência chamava atenção: um cartão da recepção da Orchestra era encontrado entre seus pertences."
tipo = 1
numero = 4
tags = Array[StringName]([&"informacao", &"orchestra"])
metadata/_custom_type_script = "uid://cmesj3xfmjv7o"
