[resource]
script = ExtResource("1_7hecu")
id = &"in_00018"
titulo = "Orchestra - Parte 3"
descricao = "Pouco tempo depois, Dra. Maria fez uma viagem só de ida para a capital. Durante a madrugada. Sem nenhuma testemunha. Em seu laboratório, foi encontrado um caderno parcialmente queimado, contendo fórmulas incompletas sobre rupturas dimensionais, além de um bilhete escrito às pressas: 

\"Cansei. Tô indo pra capital. Não me procurem.\"
O laboratório permanecia praticamente intacto. A mala continuava no armário. O carro seguia na garagem. Sobre o chão, havia apenas pequenas manchas de uma substância reluzente que ninguém conseguiu identificar."
tipo = 1
numero = 3
tags = Array[StringName]([&"informacao", &"orchestra"])
metadata/_custom_type_script = "uid://cmesj3xfmjv7o"
