[resource]
script = ExtResource("1_soir2")
id = &"in_00013"
titulo = "Khainokata- Parte 3"
descricao = "Moradores de Belacidade começaram a apresentar comportamentos idênticos, mesmo sem qualquer ligação aparente entre si. Comerciantes, agricultores, mineradores e professores passaram a repetir os mesmos gestos e a marcar as portas de suas casas com símbolos desconhecidos. Nenhum deles admitia participar de um culto, mas todos defendiam, com unhas e dentes, um tal de propósito maior."
numero = 3
metadata/_custom_type_script = "uid://cmesj3xfmjv7o"
