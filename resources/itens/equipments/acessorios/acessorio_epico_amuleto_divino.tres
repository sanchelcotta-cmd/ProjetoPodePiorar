[resource]
script = ExtResource("1_i4qyf")
icon = SubResource("ppp_item_icon")
id = &"ac_00001"
display_name = "Amuleto Divino"
description = "Pode ser sintonizado uma única vez, por um único personagem. A escolha é irreversível e não destrói o amuleto. Enquanto o personagem vinculado o equipar, fica imune a Doença, Tristeza, Terror e Maldições. A proteção também remove Doença, Tristeza e Terror já ativos. Ao desequipar, perde a proteção; ao reequipar, ela volta. Outros personagens podem equipá-lo, mas não recebem a imunidade nem podem sintonizá-lo. Sacrifício Divino ressuscita um aliado, mas destrói o amuleto."
rarity = 4
acquisition_sources = 4
tags = Array[StringName]([&"acessorio", &"epica", &"imunidade"])
equipment_slot = 3
granted_passives = Array[ExtResource("3_6oeeo")]([SubResource("Resource_5vmoc")])
granted_active_skills = Array[ExtResource("2_vre7k")]([ExtResource("8_active"), ExtResource("9_attune")])
consumed_on_use = false
cannot_craft_after_consumed = true
metadata/_custom_type_script = "uid://bql64fe8a0w24"
