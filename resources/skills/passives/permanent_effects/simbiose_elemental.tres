on_granted_effects = Array[ExtResource("2_effect")]([SubResource("Effect_absorbed_weapon_traits")])
continuous_effects = Array[ExtResource("2_effect")]([SubResource("Effect_ranged_ignores_range")])
tags = Array[StringName]([&"permanent_effect", &"elemental_symbiosis", &"bound_equipment"])
