[resource]
script = ExtResource("1_passive")
id = &"permanent_passive_058"
display_name = "Simbiose Elemental"
description = "A arma absorvida ocupa permanentemente o slot de arma e não pode ser trocada. Preserva as Maestrias, passivas e bônus da arma Épica absorvida ou da evolução Épica de uma arma comum. Distância ignora o limite de alcance e a redução de dano pelos hexes até o alvo; Lâmina causa Sangramento em todo ataque que causar dano; Impacto causa Atordoamento em todo ataque que causar dano."
