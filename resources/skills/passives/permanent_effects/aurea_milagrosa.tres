description = "O personagem fica imune a Doença, Tristeza, Terror e Maldições. Remove esses efeitos que já possuía ao receber a bênção."
continuous_effects = Array[ExtResource("2_effect")]([SubResource("Status_immunity")])
tags = Array[StringName]([&"permanent_effect", &"immunity", &"curses"])
