[resource]
script = ExtResource("2_passive")
id = &"enemy_passive_006"
display_name = "Eles Sabem Demais"
description = "Com 1 ou 2 Informações, tem Ataque e Stamina 2. A partir de 3, usa a quantidade de Informações do grupo, até o máximo de 5 no Subúrbio, 10 no Baixo-Centro e 15 no Centro. A Stamina determina quantos hexes pode andar no turno."
trigger = 21
activation_context = 1
minimum_group_information_count = 1
effects = Array[ExtResource("1_effect")]([SubResource("Effect_attack"), SubResource("Effect_stamina")])
tags = Array[StringName]([&"homem_de_preto", &"informacao", &"atributo_variavel"])
metadata/_custom_type_script = "res://scripts/resources/skills/passive_skill_data.gd"
