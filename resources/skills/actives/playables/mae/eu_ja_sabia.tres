[gd_resource type="Resource" script_class="ActiveSkillData" format=3]

[ext_resource type="Script" path="res://scripts/resources/skills/skill_effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://scripts/resources/skills/active_skill_data.gd" id="2_active"]

[sub_resource type="Resource" id="Resource_reveal_dangers"]
script = ExtResource("1_effect")
effect_type = 8
reveal_presentation = 1
tags_filter = Array[StringName]([&"catastrophe", &"cursed", &"trap", &"event_bad"])

[resource]
script = ExtResource("2_active")
id = &"playable_active_003"
display_name = "Eu Já Sabia Que Isso Ia Acontecer"
description = "Durante este turno, destaca em vermelho Catástrofes, Maldições, Armadilhas e Eventos de valência Ruim (inclusive Efeitos Permanentes) ainda ativáveis no alcance da Estamina. Clique em um hex destacado para ler o título e a classificação. Uma vez por Rodada."
use_context = 1
target_mode = 6
range_mode = 1
max_uses_per_round = 1
effects = Array[ExtResource("1_effect")]([SubResource("Resource_reveal_dangers")])
tags = Array[StringName]([&"mae"])
