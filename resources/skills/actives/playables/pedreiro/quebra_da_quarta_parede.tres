[resource]
script = ExtResource("2_active")
id = &"playable_active_008"
display_name = "Quebra da (Quarta) Parede"
description = "Ao chegar a um bloco de Evento Ambíguo ou Ruim, Efeito Permanente Ambíguo ou Ruim, Catástrofe ou Armadilha, pode destruí-lo antes da ativação. Seus efeitos não acontecem. Uma vez por Dia; o evento impedido fica fora dos sorteios por 3 Rodadas."
