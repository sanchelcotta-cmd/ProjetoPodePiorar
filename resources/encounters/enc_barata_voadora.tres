[ext_resource type="Script" path="res://scripts/resources/encounters/encounter_member_data.gd" id="2_member"]
[ext_resource type="Resource" path="res://resources/entities/entities_general/barata_voadora.tres" id="3_barata"]

[sub_resource type="Resource" id="Resource_barata"]
script = ExtResource("2_member")
