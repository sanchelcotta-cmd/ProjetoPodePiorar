[resource]
script = ExtResource("1_63jm4")
id = &"in_00008"
titulo = "Homens de Preto - Parte 3"
descricao = "Quando Dionísio começou a compartilhar suas descobertas em um fórum online, desapareceu sem deixar vestígios. Dona Cecília, sua esposa, ficou desesperada, procurando pelo marido enquanto os vizinhos acreditavam que tudo não passava de mais uma loucura de bêbado. Pouco depois, ela passou a relatar a presença constante de homens vestidos de preto observando sua casa durante a madrugada. Ninguém acreditou em Dona Cecília. Dias depois, ela também desapareceu."
tipo = 2
numero = 3
metadata/_custom_type_script = "uid://cmesj3xfmjv7o"
