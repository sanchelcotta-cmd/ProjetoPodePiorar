[resource]
script = ExtResource("1_q1jy5")
id = 19
titulo = "Orchestra - Parte 5"
descricao = "A obsessão de Dr. Enzo atingiu seu ápice. Notas e gravações de segurança interna demonstravam que o cientista havia desenvolvido uma tecnologia capaz de abrir portais dimensionais. Pouco a pouco, Dr. Enzo tornou-se uma figura estranhamente desumana. Consumido por suas descobertas, mostrava-se cada vez mais hostil aos demais e acreditava estar conduzindo a humanidade ao nascimento de uma nova realidade."
tipo = 1
numero = 5
metadata/_custom_type_script = "uid://cmesj3xfmjv7o"
