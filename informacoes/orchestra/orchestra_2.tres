[resource]
script = ExtResource("1_y3s2x")
id = &"in_00017"
titulo = "Orchestra - Parte 2"
descricao = "Dra. Maria cresceu em Belacidade e era uma boa mulher. Estudou Química e Física Quântica e era respeitada pela população, apesar de bastante controversa. A cientista acusava Dr. Enzo de abandonar a ciência em favor de uma obsessão: acreditava que ele buscava alcançar a imortalidade a qualquer custo. Maria afirmava possuir gravações feitas secretamente dentro da Orchestra, durante as duas semanas em que trabalhou por lá. Nas imagens, era possível ver humanos e animais expostos a substâncias reluzentes, seguidas por alterações grotescas em seus corpos. Dr. Enzo, naturalmente, refutou as acusações, afirmando que tudo não passava de uma montagem."
tipo = 1
numero = 2
metadata/_custom_type_script = "uid://cmesj3xfmjv7o"
