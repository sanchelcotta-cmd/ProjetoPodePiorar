[resource]
script = ExtResource("1_b5wp1")
id = &"in_00014"
titulo = "Khainokata- Parte 4"
descricao = "O altar dedicado a Khainokata transformou-se em um local de peregrinação. Objetos valiosos eram oferecidos como demonstração de devoção. Yngrid, uma jovem influencer, decidiu zombar da situação, oferecendo um rolo de papel higiênico durante uma noite. Três dias depois, seu carro capotou na rodovia — e a única coisa encontrada intacta após o acidente foi um pacote de papel higiênico."
numero = 4
metadata/_custom_type_script = "uid://cmesj3xfmjv7o"
