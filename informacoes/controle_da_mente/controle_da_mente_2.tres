[resource]
script = ExtResource("1_esutj")
id = &"in_00002"
titulo = "Controle da Mente - Parte 2"
descricao = "Adolescentes que haviam instalado o aplicativo começaram a apresentar febre alta, tremores e lapsos de consciência. Os pais culparam o tempo na internet. E, dessa vez, não estavam tão errados assim. Durante uma tarde, todos receberam a mesma notificação em seus aparelhos:

\"Conforme autorizado nos Termos de Uso, seu cérebro agora pertence a nós\".
A transformação foi instantânea. Os infectados perderam a capacidade de raciocinar, mas continuavam repetindo as dancinhas que haviam aprendido no aplicativo."
tipo = 3
numero = 2
metadata/_custom_type_script = "uid://cmesj3xfmjv7o"
