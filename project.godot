; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Projeto de Jogo"
run/main_scene="res://scenes/ui/playable_selection.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

UniversalFontScale="*res://scripts/ui/universal_font_scale.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/size/window_width_override=1656
window/size/window_height_override=932
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://fonts/UbuntuSans-Regular.ttf"
theme/default_font_size=21

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
2d/snap/snap_2d_transforms_to_pixel=true
