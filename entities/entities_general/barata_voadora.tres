[resource]
script = ExtResource("1_srm6m")
id = &"e0001"
display_name = "Barata Gigante Voadora"
description = "Inimigo corpo a corpo voador que pode causar Terror."
narrative_description = "“Primeiro você escuta o bater das asas, ritmado e pesado, como um
tambor ecoando pela rua. Então a criatura finalmente aparece. É uma
barata, do tamanho de uma cabra. Por um instante você pensa que isso
já é ruim o bastante. Mas é pior – ela voa."
